<Window x:Class="StageManager.App.StripWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StageManager.App"
        Title="Stage Manager"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Focusable="False" Width="200" Height="600">
    <Window.Resources>
        <!-- Replaced with null by StripWindow when rendering is not hardware accelerated: software blur is too slow per frame. -->
        <DropShadowEffect x:Key="ThumbShadow" BlurRadius="14" ShadowDepth="2" Opacity="0.45" />
        <DropShadowEffect x:Key="TextShadow" BlurRadius="4" ShadowDepth="0" Opacity="0.9" />
        <DataTemplate DataType="{x:Type local:StageItem}">
            <Border x:Name="Card" Margin="12,6" Padding="8" CornerRadius="10" Background="#00FFFFFF" Cursor="Hand"
                    RenderTransformOrigin="0.5,0.5" MouseLeftButtonDown="OnCardPressed">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="CardScale" />
                </Border.RenderTransform>
                <StackPanel>
                    <Grid>
                        <Border x:Name="ThumbBox" CornerRadius="6" Background="#66202020" MinHeight="72" ClipToBounds="True"
                                Effect="{DynamicResource ThumbShadow}">
                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" MaxHeight="120"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-6,0,0,-6"
                                Width="36" Height="36" CornerRadius="8" Background="#E0202020">
                            <Grid>
                                <Image Source="{Binding Icon}" Width="24" Height="24" />
                                <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding InitialVisibility}" />
                            </Grid>
                        </Border>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0" Padding="6,1"
                                CornerRadius="8" Background="#E0202020" Visibility="{Binding CountVisibility}">
                            <TextBlock Text="{Binding Count}" Foreground="White" FontSize="11" />
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding Title}" Margin="0,10,0,0" Foreground="White" FontSize="12"
                               TextTrimming="CharacterEllipsis" TextAlignment="Center" Effect="{DynamicResource TextShadow}" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <!-- Hover: a light wash and a gentle lift. -->
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="#2AFFFFFF" />
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1.04" Duration="0:0:0.14">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1.04" Duration="0:0:0.14">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>
    <!-- The whole strip slides off the edge when the active stage covers its area; see StripWindow.Slide. -->
    <Grid x:Name="StripRoot">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="StripSlide" />
        </Grid.RenderTransform>
        <!-- Lit up while the user drags a window over the strip: "drop it here to send it to the strip". -->
        <Border x:Name="DropHighlight" Margin="6,10" CornerRadius="14" Background="#26FFFFFF"
                BorderBrush="#99FFFFFF" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False" />
        <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="Cards" ItemsSource="{Binding Items}" Margin="0,16" />
        </ScrollViewer>
    </Grid>
</Window>
