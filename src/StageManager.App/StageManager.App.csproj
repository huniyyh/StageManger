<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>StageManager.App</RootNamespace>
    <AssemblyName>StageManager</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\stagemanager.ico</ApplicationIcon>
    <!-- Program.Main runs Velopack's hooks before WPF starts. -->
    <StartupObject>StageManager.App.Program</StartupObject>
    <!-- Bumped by build/publish.ps1 (-Version) and the release workflow; must match the packed version. -->
    <Version>0.1.0</Version>
    <Product>Stage Manager</Product>
    <Authors>huniyyh</Authors>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only used for the tray icon; keep its namespaces out of every other file. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Where the app looks for new releases: the GitHub repository whose Releases the workflow publishes to. -->
    <AssemblyMetadata Include="UpdateRepository" Value="https://github.com/huniyyh/StageManger" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StageManager.Core\StageManager.Core.csproj" />
    <ProjectReference Include="..\StageManager.Win32\StageManager.Win32.csproj" />
  </ItemGroup>

</Project>
